# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Use MongoDB Atlas Cloud URI on Render)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/jobportal?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/jobportal?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL (Your Vercel URL - no trailing slash)
# Example: https://job-hub-frontend.vercel.app
CLIENT_URL=https://your-frontend-domain.vercel.app
