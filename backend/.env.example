# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas Cloud URI)
# Example Local: mongodb://127.0.0.1:27017/jobportal
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/jobportal?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/jobportal

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
